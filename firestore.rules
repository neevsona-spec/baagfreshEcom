rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Admin check against trusted /admins/{uid} collection or bootstrapped master admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email in [
          'neevsona@gmail.com',
          'baagfresh@gmail.com',
          'admin@baagfresh.in',
          'maan1986@gmail.com',
          'admin@baagfresh.com'
        ]
      );
    }

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins registry - restricted to admins and self-registration for authorized admins
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
    }

    // User profiles - customers can only read and write their own profile; admins can read and manage
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Customer orders - customers access their own orders; admins can manage all orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Customer wishlists - private to the user
    match /wishlists/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Product reviews - public to read, verified create, owner/admin update & delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Live Product Catalog - public read, admin write/manage
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store Settings & Live Website Content - public read, admin write
    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo Codes - public read for validation, admin write
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Wholesale Inquiries - public submit, admin manage
    match /wholesale_inquiries/{inquiryId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }
  }
}

